# Copy to .env and fill in. Never commit the real .env.

# --- Notion (required) ---
# Internal integration token from https://www.notion.so/my-integrations
# Then share the database with that integration (••• → Connections).
NOTION_TOKEN=secret_xxx
# The database ID (the 32-char id in the database URL).
NOTION_DATABASE_ID=c44f1d50488642e99316f700b19e9182

# --- X / Twitter (required for --live X posts) ---
# From an X developer app with Read+Write permission (developer.x.com).
# Consumer keys identify the app; access tokens authorize posting as your account.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Optional ---
# 280 for standard X; set 25000 if the posting account has X Premium.
MAX_TWEET_LEN=280
